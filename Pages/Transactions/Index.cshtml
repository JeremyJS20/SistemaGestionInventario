                            <td data-slot="table-cell" class="p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]">
                                <div>
                                    <div>
                                        <select
                                                required
                                                style="padding-right: 30px"
                                                data-id="${transaction.id}"
                                                class="status-select file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground border-input h-9 w-full min-w-0 rounded-md border-none bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm focus:outline-none focus:ring-0 focus:shadow-none focus:border-none aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive">
                                            <option value="0" ${transaction.state == 0 ? "selected" : ""}>Pendiente</option>
                                            <option value="1" ${transaction.state == 1 ? "selected" : ""}>Completado</option>
                                            <option value="2" ${transaction.state == 2 ? "selected" : ""}>Cancelado</option>
                                        </select>
                                    </div>
                                </div>
                            </td>
                            <td data-slot="table-cell" class="p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]">
                                <div>
                                    <p class="text-sm">${(new Date(transaction.date)).toLocaleDateString()}</p>
                                    <p class="text-xs text-muted-foreground">${(new Date(transaction.date)).toLocaleTimeString()}</p>
                                </div>
                            </td>
                            <td data-slot="table-cell" class="p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]">
                                <button data-id="${transaction.id}" data-slot="button" class="action-btn inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 h-8 rounded-md gap-1.5 px-3 has-[>svg]:px-2.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-icon lucide-eye w-4 h-4"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                            </td>
                        </tr>
                    `
                })

                tableBody.innerHTML = innerHtml;

                document.querySelectorAll('.status-select').forEach(select => {
                    select.addEventListener("input", e => {
                        const id = select.getAttribute('data-id');
                        const state = e.target.value;

                        document.querySelector("#deleteId").value = id;
                        document.querySelector("#deleteState").value = state;

                        document.querySelector('#updateForm').submit();
                    })
                })

                document.querySelectorAll('.action-btn').forEach(btn => {
                    btn.addEventListener("click", () => {
                        const id = btn.getAttribute('data-id');

                        fetch(`@Url.Page("", "Transaction")&id=${id}`, {
                            method: 'GET',
                        })
                        .then(response => response.json())
                        .then(data => {
                            document.querySelector("#actionType").innerHTML = data.type == 0 ? `
                                        <span data-slot="badge" class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 [&>svg]:size-3 gap-1 [&>svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden border-transparent [a&]:hover:bg-primary/90 bg-green-100 text-green-800">
                                            <div class="flex items-center gap-1">
