<script>
    document.addEventListener("DOMContentLoaded", () => {
        const entradaTab = document.querySelector("#entradaTab");
        const salidaTab = document.querySelector("#salidaTab");
        const ajusteTab = document.querySelector("#ajusteTab");

        entradaTab.addEventListener("click", () => {
            document.querySelector("#cantidadInput").classList.remove("hidden");
            document.querySelector("#precioInput").classList.remove("hidden");
            document.querySelector("#cantidadAjustesInput").classList.add("hidden");
        })

        salidaTab.addEventListener("click", () => {
            document.querySelector("#cantidadInput").classList.remove("hidden");
            document.querySelector("#precioInput").classList.remove("hidden");
            document.querySelector("#cantidadAjustesInput").classList.add("hidden");
        })

        ajusteTab.addEventListener("click", () => {
            document.querySelector("#cantidadInput").classList.add("hidden");
            document.querySelector("#precioInput").classList.add("hidden");
            document.querySelector("#cantidadAjustesInput").classList.remove("hidden");
        })
    })
</script>