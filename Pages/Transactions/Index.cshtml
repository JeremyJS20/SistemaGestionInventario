<script>
    document.addEventListener("DOMContentLoaded", () => {

        const transactionTypeInput = document.querySelector("#TransactionDto_Type");

        const entradaTab = document.querySelector("#entradaTab");
        const salidaTab = document.querySelector("#salidaTab");
        const ajusteTab = document.querySelector("#ajusteTab");

        const cantidadInput = document.querySelector("#cantidadInput");
        const precioInput = document.querySelector("#precioInput");
        const cantidadAjustesInput = document.querySelector("#cantidadAjustesInput");

        const createBtn = document.querySelector('#create-btn');
        let form = document.querySelector('#transactionForm');
        let closeBtn = document.querySelector('#close-btn');
        let cancelBtn = document.querySelector('#cancel-btn');

        let searchInput = document.querySelector('#searchInput');
        let typeSelect = document.querySelector('#typeSelect');
        let warehouseSelect = document.querySelector('#warehouseSelect');
        let stateSelect = document.querySelector('#stateSelect');

        entradaTab.addEventListener("click", () => {
            cantidadInput.classList.remove("hidden");
            cantidadInput.children[1].value = 0;

            precioInput.classList.remove("hidden");
            precioInput.children[1].value = 0;

            cantidadAjustesInput.classList.add("hidden");
            cantidadAjustesInput.children[1].value = 0;

            transactionTypeInput.value = 0;
        })

        salidaTab.addEventListener("click", () => {
            cantidadInput.classList.remove("hidden");
            cantidadInput.children[1].value = 0;

            precioInput.classList.remove("hidden");
            precioInput.children[1].value = 0;
            
            cantidadAjustesInput.classList.add("hidden");
            cantidadAjustesInput.children[1].value = 0;
            
            transactionTypeInput.value = 1;
        })

        ajusteTab.addEventListener("click", () => {
            cantidadInput.classList.add("hidden");
            cantidadInput.children[1].value = 0;

            precioInput.classList.add("hidden");
            precioInput.children[1].value = 0;
            
            cantidadAjustesInput.classList.remove("hidden");
            cantidadAjustesInput.children[1].value = 0;
            
            transactionTypeInput.value = 2;
        })

        createBtn.addEventListener('click', () => {
            form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
        })

        closeBtn.addEventListener('click', () => {
            form.reset();

            const validationMessages = form.querySelectorAll(".text-red-600");
            validationMessages.forEach(el => el.textContent = "");
        })

        cancelBtn.addEventListener('click', () => {
            form.reset();

            const validationMessages = form.querySelectorAll(".text-red-600");
            validationMessages.forEach(el => el.textContent = "");
        })

        form.addEventListener('submit', (e) => {
            e.preventDefault();

            let form = e.target;
            let formData = new FormData(form);

            fetch(form.action + '?handler=Endpoint', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': formData.get('__RequestVerificationToken')
                },
                body: formData
            })
            .then(response => response.json())
            .then(result => {
                form.querySelectorAll('[data-valmsg-for]').forEach(el => {
                    el.textContent = '';
                });

                if (result.success) {
                    window.location.reload();
                } else {
                    for (let field in result.errors) {
                        let msg = result.errors[field];
                        let span = form.querySelector(`[data-valmsg-for="${field}"]`);
                        if (span) {
                            span.textContent = msg;
                        }
                    }
                }
            })
            .catch(err => {
                console.error('Submit error', err);
            });
        });

        const fillTable = (search, type, warehouseId, state) => {
            fetch(`@Url.Page("", "TransactionTable")&search=${search}&type=${type}&warehouseId=${warehouseId}&state=${state}`, {
                method: 'GET',
            })
            .then(response => response.json())
            .then(data => {
                const tableBody = document.querySelectorAll("tbody")[0]

                let innerHtml = "";
                data.forEach(transaction => {
                    innerHtml += `
                        <tr data-slot="table-row" class="hover:bg-muted/50 data-[state=selected]:bg-muted border-b transition-colors">
                            <td data-slot="table-cell" class="p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]">
                                ${
                                    transaction.type == 0 ? `
                                        <span data-slot="badge" class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 [&>svg]:size-3 gap-1 [&>svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden border-transparent [a&]:hover:bg-primary/90 bg-green-100 text-green-800">
                                            <div class="flex items-center gap-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-down-icon lucide-circle-arrow-down w-4 h-4"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="m8 12 4 4 4-4"/></svg>
                                                <span class="capitalize">inbound</span>
                                            </div>
                                        </span>
                                    ` : transaction.type == 1 ? `
                                        <span data-slot="badge" class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 [&>svg]:size-3 gap-1 [&>svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden border-transparent [a&]:hover:bg-primary/90 bg-red-100 text-red-800">
                                            <div class="flex items-center gap-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-up-icon lucide-circle-arrow-up w-4 h-4"><circle cx="12" cy="12" r="10"/><path d="m16 12-4-4-4 4"/><path d="M12 16V8"/></svg>
                                                <span class="capitalize">outbound</span>
                                            </div>
                                        </span>
                                    ` : `
                                        <span data-slot="badge" class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 [&>svg]:size-3 gap-1 [&>svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden border-transparent [a&]:hover:bg-primary/90 bg-yellow-100 text-yellow-800">
                                            <div class="flex items-center gap-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings-icon lucide-settings w-4 h-4"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
                                                <span class="capitalize">adjustment</span>
                                            </div>
                                        </span>
                                    `
                                }
                            </td>
                            <td data-slot="table-cell" class="p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]">
                                <div>
                                    <p class="font-medium">${transaction.article.name}</p>
                                    <p class="text-sm text-muted-foreground">${transaction.article.code}</p>
                                </div>
                            </td>
                            <td data-slot="table-cell" class="p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]">
                                <div class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2-icon lucide-building-2 w-4 h-4"><path d="M10 12h4"/><path d="M10 8h4"/><path d="M14 21v-3a2 2 0 0 0-4 0v3"/><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"/><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"/></svg>
                                    ${transaction.warehouse.name}
                                </div>
                            </td>
                            <td data-slot="table-cell" class="p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]">
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold">${transaction.amount}</span>
                                </div>
                            </td>
                            <td data-slot="table-cell" class="p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium">${(transaction.type == 2 ? '-' : '$'+transaction.unitPrice)}</span>
                                </div>
                            </td>
                            <td data-slot="table-cell" class="p-2 align-middle whitespace-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]">
                                <div>
                                        <p class="text-sm">${transaction.motive}</p>
                                        <p class="text-xs text-muted-foreground">${transaction.reference ?? ""}</p>
                                </div>
