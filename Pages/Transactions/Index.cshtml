                                        <span data-slot="badge" class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 [&>svg]:size-3 gap-1 [&>svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden border-transparent [a&]:hover:bg-primary/90 bg-yellow-100 text-yellow-800">
                                            <div class="flex items-center gap-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings-icon lucide-settings w-4 h-4"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
                                                <span class="capitalize">adjustment</span>
                                            </div>
                                        </span>
                                    `;
                            document.querySelector("#actionState").innerHTML = data.state == 1 ? `
                                        <span data-slot="badge" class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 [&>svg]:size-3 gap-1 [&>svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden border-transparent [a&]:hover:bg-primary/90 bg-green-100 text-green-800">
                                            <div class="flex items-center gap-1">
                                                <span class="capitalize">Completado</span>
                                            </div>
                                        </span>
                                    ` : data.state == 2 ? `
                                        <span data-slot="badge" class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 [&>svg]:size-3 gap-1 [&>svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden border-transparent [a&]:hover:bg-primary/90 bg-red-100 text-red-800">
                                            <div class="flex items-center gap-1">
                                                <span class="capitalize">Cancelado</span>
                                            </div>
                                        </span>
                                    ` : `
                                        <span data-slot="badge" class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 [&>svg]:size-3 gap-1 [&>svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden border-transparent [a&]:hover:bg-primary/90 bg-yellow-100 text-yellow-800">
                                            <div class="flex items-center gap-1">
                                                <span class="capitalize">Pendiente</span>
                                            </div>
                                        </span>
                                    `;
                            document.querySelector("#actionArticle").innerHTML = data.article.name;
                            document.querySelector("#actionWarehouse").innerHTML = data.warehouse.name;
                            document.querySelector("#actionAmount").innerHTML = data.amount;
                            document.querySelector("#actionUnitPrice").innerHTML = data.unitPrice;
                            document.querySelector("#actionMotive").innerHTML = data.motive;
                            document.querySelector("#actionReference").innerHTML = data.reference;
                            document.querySelector("#actionDate").innerHTML = (new Date(data.date)).toLocaleDateString();
                            document.querySelector("#actionTime").innerHTML = (new Date(data.date)).toLocaleTimeString();

                            if (data.type == 2) {
                                document.querySelector("#actionUnitPriceContainer").classList.add("hidden");
                            } else {
                                document.querySelector("#actionUnitPriceContainer").classList.remove("hidden");
                            }

                            document.querySelector("#action-btn").click();
                        })
                    })
                })
            })
        }

        fillTable("", -1, -1, -1);

        searchInput.addEventListener('input', (e) => {
            fillTable(e.target.value, typeSelect.value, warehouseSelect.value, stateSelect.value);
        })

        typeSelect.addEventListener('input', (e) => {
            fillTable(searchInput.value, e.target.value, warehouseSelect.value, stateSelect.value);
        })

        warehouseSelect.addEventListener('input', (e) => {
            fillTable(searchInput.value, typeSelect.value, e.target.value, stateSelect.value);
        })

        stateSelect.addEventListener('input', (e) => {
            fillTable(searchInput.value, typeSelect.value, warehouseSelect.value, e.target.value);
        })
    })
</script>