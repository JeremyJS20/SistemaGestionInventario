<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Gestión de Inventario</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        header {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            margin-bottom: 25px;
            text-align: center;
        }

        h1 {
            color: #667eea;
            font-size: 2em;
            margin-bottom: 5px;
        }

        .subtitle {
            color: #666;
            font-size: 0.9em;
        }

        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-bottom: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .card h2 {
            color: #667eea;
            margin-bottom: 20px;
            font-size: 1.5em;
            border-bottom: 3px solid #667eea;
            padding-bottom: 10px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            color: #333;
            font-weight: 600;
        }

        select, input, button {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: all 0.3s;
        }

        select:focus, input:focus {
            outline: none;
            border-color: #667eea;
        }

        button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            cursor: pointer;
            font-weight: bold;
            margin-top: 10px;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        button:active {
            transform: translateY(0);
        }

        .btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
        }

        .btn-entrada {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        }

        .btn-salida {
            background: linear-gradient(135deg, #ee0979 0%, #ff6a00 100%);
        }

        .btn-ajuste {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #e0e0e0;
        }

        th {
            background: #667eea;
            color: white;
            font-weight: 600;
        }

        tr:hover {
            background: #f5f5f5;
        }

        .stock-low {
            background: #ffebee !important;
            color: #c62828;
            font-weight: bold;
        }

        .stock-ok {
            color: #2e7d32;
        }

        .alert {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 15px;
            animation: slideIn 0.3s;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border-left: 4px solid #28a745;
        }

        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border-left: 4px solid #dc3545;
        }

        .alert-warning {
            background: #fff3cd;
            color: #856404;
            border-left: 4px solid #ffc107;
        }

        @keyframes slideIn {
            from {
                transform: translateY(-20px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px;
            border-radius: 10px;
            color: white;
            text-align: center;
        }

        .stat-number {
            font-size: 2em;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 0.9em;
            opacity: 0.9;
        }

        .transaction-badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 0.8em;
            font-weight: bold;
        }

        .badge-entrada {
            background: #d4edda;
            color: #155724;
        }

        .badge-salida {
            background: #f8d7da;
            color: #721c24;
        }

        .badge-ajuste {
            background: #fff3cd;
            color: #856404;
        }

        @media (max-width: 768px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }
            .btn-group {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>📦 Sistema de Gestión de Inventario</h1>
            <p class="subtitle">Control total de entradas, salidas y ajustes de inventario</p>
        </header>

        <div id="alertContainer"></div>

        <div class="stats">
            <div class="stat-card">
                <div class="stat-number" id="statEntradas">0</div>
                <div class="stat-label">Total Entradas</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="statSalidas">0</div>
                <div class="stat-label">Total Salidas</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="statAjustes">0</div>
                <div class="stat-label">Ajustes</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="statTransacciones">0</div>
                <div class="stat-label">Transacciones</div>
            </div>
        </div>

        <div class="main-grid">
            <div class="card">
                <h2>📊 Inventario Actual</h2>
                <table id="inventoryTable">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Stock</th>
                            <th>Mínimo</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody id="inventoryBody"></tbody>
                </table>
            </div>

            <div class="card">
                <h2>➕ Registrar Transacción</h2>
                <div class="form-group">
                    <label>Producto</label>
                    <select id="productSelect"></select>
                </div>
                <div class="form-group">
                    <label>Cantidad</label>
                    <input type="number" id="quantityInput" min="1" placeholder="Ingrese cantidad">
                </div>
                <div class="form-group">
                    <label>Motivo</label>
                    <input type="text" id="reasonInput" placeholder="Motivo de la transacción">
                </div>
                <div class="btn-group">
                    <button class="btn-entrada" onclick="procesarTransaccion('ENTRADA')">📥 Entrada</button>
                    <button class="btn-salida" onclick="procesarTransaccion('SALIDA')">📤 Salida</button>
                    <button class="btn-ajuste" onclick="procesarTransaccion('AJUSTE')">⚙️ Ajuste</button>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>📜 Historial de Transacciones</h2>
            <div style="overflow-x: auto;">
                <table id="transactionTable">
                    <thead>
                        <tr>
                            <th>Fecha/Hora</th>
                            <th>Tipo</th>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Motivo</th>
                        </tr>
                    </thead>
                    <tbody id="transactionBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Clase Transaction
        class Transaction {
            constructor(type, productId, quantity, reason = '', userId = null) {
                this.id = Date.now() + Math.random();
                this.type = type;
                this.productId = productId;
                this.quantity = quantity;
                this.reason = reason;
                this.userId = userId;
                this.timestamp = new Date().toISOString();
            }
        }

        // Base de datos en memoria
        let inventory = [
            { id: 1, name: 'Laptop Dell', stock: 50, minStock: 10 },
            { id: 2, name: 'Mouse Logitech', stock: 100, minStock: 20 },
            { id: 3, name: 'Teclado Mecánico', stock: 30, minStock: 15 },
            { id: 4, name: 'Monitor Samsung', stock: 25, minStock: 8 },
            { id: 5, name: 'Webcam HD', stock: 15, minStock: 5 }
        ];

        let transactionHistory = [];

        // Funciones principales
        function registrarEntrada(productId, quantity, reason) {
            const product = inventory.find(p => p.id === productId);
            if (!product) return { success: false, message: 'Producto no encontrado' };

            product.stock += quantity;
            const transaction = new Transaction('ENTRADA', productId, quantity, reason);
            transactionHistory.push(transaction);

            return {
                success: true,
                message: `Entrada registrada: +${quantity} unidades de ${product.name}`,
                newStock: product.stock,
                transaction
            };
        }

        function registrarSalida(productId, quantity, reason) {
            const product = inventory.find(p => p.id === productId);
            if (!product) return { success: false, message: 'Producto no encontrado' };

            if (product.stock < quantity) {
                return { 
                    success: false, 
                    message: `Stock insuficiente. Disponible: ${product.stock}, Solicitado: ${quantity}` 
                };
            }

            product.stock -= quantity;
            const transaction = new Transaction('SALIDA', productId, quantity, reason);
            transactionHistory.push(transaction);

            const alert = product.stock < product.minStock 
                ? `⚠️ ALERTA: Stock bajo el mínimo (${product.minStock})` 
                : '';

            return {
                success: true,
                message: `Salida registrada: -${quantity} unidades de ${product.name}`,
                newStock: product.stock,
                transaction,
                alert
            };
        }

        function registrarAjuste(productId, newQuantity, reason) {
            const product = inventory.find(p => p.id === productId);
            if (!product) return { success: false, message: 'Producto no encontrado' };

            const difference = newQuantity - product.stock;
            const oldStock = product.stock;
            product.stock = newQuantity;

            const transaction = new Transaction('AJUSTE', productId, difference, reason);
            transactionHistory.push(transaction);

            return {
                success: true,
                message: `Ajuste: ${product.name} - Anterior: ${oldStock}, Nuevo: ${newQuantity}`,
                difference,
                newStock: product.stock,
                transaction
            };
        }

        // UI Functions
        function showAlert(message, type = 'success') {
            const container = document.getElementById('alertContainer');
            const alert = document.createElement('div');
            alert.className = `alert alert-${type}`;
            alert.textContent = message;
            container.appendChild(alert);

            setTimeout(() => alert.remove(), 5000);
        }

        function updateInventoryTable() {
            const tbody = document.getElementById('inventoryBody');
            tbody.innerHTML = '';

            inventory.forEach(product => {
                const row = tbody.insertRow();
                const isLow = product.stock < product.minStock;
                if (isLow) row.className = 'stock-low';

                row.innerHTML = `
                    <td>${product.name}</td>
                    <td>${product.stock}</td>
                    <td>${product.minStock}</td>
                    <td class="${isLow ? '' : 'stock-ok'}">${isLow ? '⚠️ Bajo' : '✅ OK'}</td>
                `;
            });
        }

        function updateTransactionTable() {
            const tbody = document.getElementById('transactionBody');
            tbody.innerHTML = '';

            transactionHistory.slice().reverse().slice(0, 20).forEach(t => {
                const row = tbody.insertRow();
                const product = inventory.find(p => p.id === t.productId);
                const date = new Date(t.timestamp);

                row.innerHTML = `
                    <td>${date.toLocaleString()}</td>
                    <td><span class="transaction-badge badge-${t.type.toLowerCase()}">${t.type}</span></td>
                    <td>${product ? product.name : 'N/A'}</td>
                    <td>${t.quantity > 0 ? '+' : ''}${t.quantity}</td>
                    <td>${t.reason}</td>
                `;
            });
        }

        function updateStats() {
            const entradas = transactionHistory.filter(t => t.type === 'ENTRADA').reduce((sum, t) => sum + t.quantity, 0);
            const salidas = transactionHistory.filter(t => t.type === 'SALIDA').reduce((sum, t) => sum + t.quantity, 0);
            const ajustes = transactionHistory.filter(t => t.type === 'AJUSTE').length;

            document.getElementById('statEntradas').textContent = entradas;
            document.getElementById('statSalidas').textContent = salidas;
            document.getElementById('statAjustes').textContent = ajustes;
            document.getElementById('statTransacciones').textContent = transactionHistory.length;
        }

        function updateProductSelect() {
            const select = document.getElementById('productSelect');
            select.innerHTML = '<option value="">Seleccione un producto</option>';
            
            inventory.forEach(product => {
                const option = document.createElement('option');
                option.value = product.id;
                option.textContent = `${product.name} (Stock: ${product.stock})`;
                select.appendChild(option);
            });
        }

        function procesarTransaccion(type) {
            const productId = parseInt(document.getElementById('productSelect').value);
            const quantity = parseInt(document.getElementById('quantityInput').value);
            const reason = document.getElementById('reasonInput').value || `${type} automática`;

            if (!productId) {
                showAlert('Debe seleccionar un producto', 'error');
                return;
            }

            if (!quantity || quantity <= 0) {
                showAlert('Debe ingresar una cantidad válida', 'error');
                return;
            }

            let result;
            if (type === 'ENTRADA') {
                result = registrarEntrada(productId, quantity, reason);
            } else if (type === 'SALIDA') {
                result = registrarSalida(productId, quantity, reason);
            } else if (type === 'AJUSTE') {
                result = registrarAjuste(productId, quantity, reason);
            }

            if (result.success) {
                showAlert(result.message, 'success');
                if (result.alert) {
                    showAlert(result.alert, 'warning');
                }
                document.getElementById('quantityInput').value = '';
                document.getElementById('reasonInput').value = '';
                updateUI();
            } else {
                showAlert(result.message, 'error');
            }
        }

        function updateUI() {
            updateInventoryTable();
            updateTransactionTable();
            updateStats();
            updateProductSelect();
        }

        // Inicializar
        updateUI();
    </script>
</body>
</html>
